# =======================================================
#  ArsBot — Bot de Discord (configuración)
#  Copia este archivo a ".env" y rellena los valores.
# =======================================================

# Token del bot de Discord (https://discord.com/developers/applications)
BOT_TOKEN=

# ID del servidor (guild) de Discord. OPCIONAL.
#   - Si lo pones, los comandos se registran al instante solo en ese servidor (recomendado para probar).
#   - Si lo dejas vacío, se registran como comandos globales (pueden tardar hasta 1 hora en aparecer).
GUILD_ID=

# Conexión con el plugin de Minecraft (debe coincidir con config.yml del plugin)
SOCKET_HOST=127.0.0.1
SOCKET_PORT=25590
SOCKET_TOKEN=cambia-este-token-secreto

# Permisos (OPCIONAL). IDs separados por comas.
#   - ADMIN_ROLE_IDS: roles de Discord que pueden usar el bot.
#   - ADMIN_USER_IDS: usuarios concretos que pueden usar el bot.
#   - Si dejas ambos vacíos, se permite a cualquiera con el permiso "Administrador" en el servidor.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
